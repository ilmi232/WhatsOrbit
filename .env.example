# Salin file ini menjadi .env lalu sesuaikan.

# Password untuk masuk dashboard (WAJIB, buat yang kuat)
ADMIN_PASSWORD=

# Port & alamat server. 127.0.0.1 = hanya bisa diakses dari PC ini
# (Cloudflare Tunnel tetap bisa meneruskan dari internet).
PORT=3077
HOST=127.0.0.1

# Lewat tunnel (ngrok/Cloudflare) hanya /api yang bisa diakses.
# Isi true kalau dashboard juga ingin dibuka dari luar (tetap pakai password).
PUBLIC_DASHBOARD=false

# Alamat publik tunnel, otomatis dipakai di generator Google Form Script
PUBLIC_URL=https://nama-anda.ngrok-free.app

# Jeda acak antar pesan per device, dalam milidetik (anti-banned)
SEND_DELAY_MIN_MS=4000
SEND_DELAY_MAX_MS=10000

# Berapa kali mencoba kirim sebelum ditandai gagal
MAX_ATTEMPTS=3

# Kode negara untuk nomor yang diawali 0
DEFAULT_COUNTRY_CODE=62

# Level log: fatal | error | warn | info | debug
LOG_LEVEL=info
